# CraftCart Environment Variables
# Copy this file to .env and fill in your values

# Supabase / PostgreSQL connection string
# For external databases (e.g. AWS RDS), use: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/craftcart

# Server port
PORT=3000

# JWT secret for admin authentication (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-me

# Supabase credentials (pre-provisioned for Bolt projects)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key (for edge functions / admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
